Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"RunProgram", "[", "n_Integer", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "digitsAll", ",", "digitsRev", ",", "powers", ",", "leftPrecalculated", ",",
       "rightPrecalculated", ",", 
      RowBox[{"ans", "=", "0"}], ",", 
      RowBox[{"pow10", "=", 
       RowBox[{"10", "^", "n"}]}], ",", 
      RowBox[{"maskLimit", "=", 
       RowBox[{"2", "^", "9"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Print", "[", "\"\<Precalculating...\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"digitsAll", "=", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", 
          RowBox[{"pow10", "-", "1"}]}], "]"}], ",", "10", ",", "n"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"digitsRev", "=", 
      RowBox[{"Reverse", "[", 
       RowBox[{"digitsAll", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"powers", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"d", "^", 
         RowBox[{"(", 
          RowBox[{"2", "*", 
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", 
             RowBox[{"n", "-", "1"}]}], "]"}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"d", ",", "1", ",", "9"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"leftPrecalculated", "=", 
      RowBox[{"digitsRev", ".", 
       RowBox[{"Transpose", "[", "powers", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<Precalculating is done done done!\>\"", "]"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"rightPrecalculated", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", "leftPrecalculated", "]"}], "*", 
        RowBox[{"Range", "[", "9", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"mask", "=", "1"}], ",", 
       RowBox[{"mask", "<", "maskLimit"}], ",", 
       RowBox[{"mask", "++"}], ",", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "maskBits", ",", "activeIndices", ",", "lastCoeff", ",", "rightSub",
            ",", "leftSub", ",", "rightCounts", ",", "leftCounts", ",", 
           "commonKeys", ",", 
           RowBox[{"tmpAns", "=", "0"}]}], "}"}], ",", 
         RowBox[{
          RowBox[{"maskBits", "=", 
           RowBox[{"Reverse", "[", 
            RowBox[{"IntegerDigits", "[", 
             RowBox[{"mask", ",", "2", ",", "9"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"activeIndices", "=", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Position", "[", 
             RowBox[{"maskBits", ",", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"lastCoeff", "=", 
           RowBox[{"Times", "@@", "activeIndices"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"lastCoeff", "<=", "9"}], ",", 
            RowBox[{
             RowBox[{"rightSub", "=", 
              RowBox[{"rightPrecalculated", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "activeIndices"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"leftSub", "=", 
              RowBox[{"leftPrecalculated", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"1", "+", 
                   RowBox[{"pow10", "/", "10"}]}], ";;"}], " ", ",", 
                 "activeIndices"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"rightCounts", "=", 
              RowBox[{"Association", "[", 
               RowBox[{"Rule", "@@@", 
                RowBox[{"Tally", "[", "rightSub", "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"leftCounts", "=", 
              RowBox[{"Association", "[", 
               RowBox[{"Rule", "@@@", 
                RowBox[{"Tally", "[", "leftSub", "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"commonKeys", "=", 
              RowBox[{"Intersection", "[", 
               RowBox[{
                RowBox[{"Keys", "[", "leftCounts", "]"}], ",", 
                RowBox[{"Keys", "[", "rightCounts", "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"tmpAns", "=", 
              RowBox[{"Total", "[", 
               RowBox[{"Map", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"leftCounts", "[", "#", "]"}], "*", 
                   RowBox[{"rightCounts", "[", "#", "]"}]}], "&"}], ",", 
                 "commonKeys"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"EvenQ", "[", 
                RowBox[{"Length", "[", "activeIndices", "]"}], "]"}], ",", 
               RowBox[{"tmpAns", "=", 
                RowBox[{"-", "tmpAns"}]}]}], "]"}], ";"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<mask \>\"", ",", "mask", ",", "\"\< temp ans \>\"", ",",
             "tmpAns"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"ans", "+=", "tmpAns"}], ";"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ans", "+=", 
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "n"}], "-", "1"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ans = \>\"", ",", "ans"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "ans", "]"}], ";"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.989384940806513*^9, 3.989384940806588*^9}, {
   3.9893850980036077`*^9, 3.989385098347796*^9}, {3.989385141102902*^9, 
   3.989385152407177*^9}, {3.9893855378594627`*^9, 3.989385561418375*^9}, {
   3.989385619546254*^9, 3.989385643016127*^9}, {3.989386203663807*^9, 
   3.989386338005905*^9}, 3.989386439591605*^9},
 CellLabel->"In[6]:=",ExpressionUUID->"1c2ca462-2e92-4c87-b860-14851f45563e"],

